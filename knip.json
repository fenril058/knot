{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "entry": [
    "public/*.js",
    "test/**/*.test.ts",
    "e2e/**/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "config/**/*.cjs",
    "public/*.js",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts"
  ]
}
