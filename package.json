{
  "name": "knot",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "knot": "src/cli/main.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build:client": "rolldown -c",
    "prepare:worker-assets": "node scripts/prepare-worker-assets.ts",
    "prepare:production-config": "node scripts/prepare-production-config.ts",
    "build:worker": "npm run build:client && npm run prepare:worker-assets && wrangler deploy --dry-run --outdir dist/worker",
    "worker:types": "wrangler types",
    "d1:bootstrap": "node scripts/bootstrap-d1.ts",
    "d1:smoke": "node scripts/smoke-d1.ts",
    "test:worker-integration": "node --test test/worker/static-assets.integration.ts",
    "test:d1-integration": "node --test test/worker/d1.integration.ts",
    "check:worker": "npm run build:worker && npm run test:worker-integration && npm run test:d1-integration && node scripts/check-worker-bundle.ts",
    "watch:client": "rolldown -c --watch",
    "lint": "oxlint src public scripts test e2e",
    "lint:dead-code": "knip",
    "quality": "npm run typecheck && npm run lint && npm run lint:dead-code && npm run check:worker",
    "test:e2e": "playwright test",
    "smoke:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@hono/node-server": "^2.1.8",
    "@progfay/scrapbox-parser": "^10.1.1",
    "hono": "^4.13.16",
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@helpfeel/cosense-cli": "^1.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "knip": "^6.44.1",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rolldown": "^1.2.16",
    "scrapbox-cosense-mcp": "^0.13.0",
    "typescript": "^7.0.2",
    "wrangler": "4.156.1"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
    "request": "npm:@cypress/request@4.0.1",
    "superagent": {
      "form-data": "2.5.6"
    }
  }
}
