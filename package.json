{
  "name": "knot",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "knot": "src/cli/main.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build:client": "rolldown -c",
    "prepare:worker-assets": "node scripts/prepare-worker-assets.ts",
    "build:worker": "npm run build:client && npm run prepare:worker-assets && wrangler deploy --dry-run --outdir dist/worker",
    "worker:types": "wrangler types",
    "check:worker": "npm run build:worker && node scripts/check-worker-bundle.ts",
    "watch:client": "rolldown -c --watch",
    "lint": "oxlint src public scripts test e2e",
    "lint:dead-code": "knip",
    "quality": "npm run typecheck && npm run lint && npm run lint:dead-code && npm run check:worker",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@hono/node-server": "^2.1.1",
    "@progfay/scrapbox-parser": "^10.1.1",
    "hono": "^4.13.5",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@helpfeel/cosense-cli": "^1.14.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.4.0",
    "knip": "^6.33.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rolldown": "^1.2.6",
    "scrapbox-cosense-mcp": "^0.10.1",
    "typescript": "^7.0.2",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
    "request": "npm:@cypress/request@4.0.1",
    "superagent": {
      "form-data": "2.5.6"
    }
  }
}
