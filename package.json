{
  "name": "knot",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "knot": "src/cli/main.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build:client": "rolldown -c",
    "watch:client": "rolldown -c --watch",
    "lint": "oxlint src scripts public test e2e config",
    "lint:duplicates": "jscpd .",
    "lint:dead-code": "knip",
    "quality": "npm run typecheck && npm run lint && npm run lint:duplicates && npm run lint:dead-code",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@hono/node-server": "^2.0.8",
    "@progfay/scrapbox-parser": "10.1.1",
    "hono": "^4.12.30"
  },
  "devDependencies": {
    "@helpfeel/cosense-cli": "^1.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "jscpd": "^5.0.14",
    "knip": "^6.29.0",
    "oxlint": "^1.74.0",
    "rolldown": "^1.2.0",
    "scrapbox-cosense-mcp": "^0.7.3",
    "typescript": "^7.0.2"
  }
}
